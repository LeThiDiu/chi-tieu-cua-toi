# Sao chép file này thành .env rồi điền giá trị. KHÔNG commit file .env lên GitHub.
# Lấy key miễn phí tại Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Để TRỐNG để app tự chọn model Gemini mới nhất mà key của bạn dùng được (khuyến nghị).
# gemini-2.5-flash đã bị Google giới hạn từ 10/2026, đừng đặt lại model đó.
GEMINI_MODEL=

# Danh sách origin frontend được phép gọi API, phân tách bằng dấu phẩy.
# Ví dụ: https://ten-app.vercel.app,https://ten-mien-rieng.vn
CORS_ORIGINS=

# Chỉ cần khi chạy engine Tesseract:
# Windows: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_CMD=
# TESSERACT_LANG=vie+eng
